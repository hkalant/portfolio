# Path prefix the site is served under.
# Empty (the default) serves the app at the site root, which is what `npm run dev` uses.
# CI builds with /screenshot-editor for https://<workspace>.bitbucket.io/screenshot-editor/.
# Must be empty or match ^/[a-z0-9][a-z0-9-]*$ (no trailing slash).
NEXT_PUBLIC_BASE_PATH=
